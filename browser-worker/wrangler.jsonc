{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "browser-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "MYBROWSER",
    "remote": true
  },
  "kv_namespaces": [
    {
      "binding": "BROWSER_KV_DEMO",
      "id": "b681f4568b994739a6655a711953e3d3",
      "preview_id": "e66c9904c51147a89e7650abf88fde36"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "screenshots",
      "preview_bucket_name": "screenshots-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER",
        "class_name": "Browser"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MyDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Browser"
      ]
    }
  ]
}
