{
  "name": "@x402solana/webmcp",
  "version": "0.1.0",
  "private": false,
  "description": "Shared WebMCP + MCP primitives for SOLGPT, Clawd Compute, x402.life, and Solana Agent Desk.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./webmcp": "./dist/webmcp/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./openai": "./dist/openai/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "npm run build && node examples/node/server.mjs",
    "ask": "npm run build && node --env-file=../.env.local examples/node/ask.mjs",
    "smoke:plugin": "node scripts/smoke-plugin.mjs",
    "package:plugin": "python3 scripts/package-plugin.py clawd && python3 scripts/package-plugin.py pumpfun",
    "build:browser": "npm run build && node scripts/build-solana-browser.mjs",
    "start:browser": "npm run build:browser && node apps/solana-browser/server/index.mjs",
    "browser:run": "node scripts/solana-browser-run.mjs",
    "build:legacy": "npm --prefix \"WebMCP-main 3\" run build",
    "start:legacy": "node \"WebMCP-main 3/src/websocket-server.js\" --foreground",
    "authorize:legacy": "node \"WebMCP-main 3/src/websocket-server.js\" --new",
    "start:browser:wrangler": "npm run build:browser && node scripts/start-solana-browser.mjs --wrangler",
    "smoke:legacy": "npm run build:legacy && node scripts/smoke-legacy.mjs",
    "smoke:browser": "node scripts/smoke-solana-browser.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.18.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
