# Copy to .env and enter your OpenRouter key. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_LOG_LEVEL=warn

# Skip paid generation when running the live integration suite.
OPENROUTER_INTEGRATION_SKIP_PAID=1

# Optional local media sandboxes (absolute paths recommended).
# OPENROUTER_INPUT_DIR=/absolute/path/to/input
# OPENROUTER_OUTPUT_DIR=/absolute/path/to/output

# Remote HTTP mode (npm run start:http). Generate a random token of 32+ characters.
# MCP_AUTH_TOKEN=
# MCP_ALLOWED_ORIGINS=https://your-browser-client.example
# PORT=8080
